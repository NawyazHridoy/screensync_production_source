# ============================================================================
# ScreenSync — Environment Configuration Template (.env.example)
# ============================================================================
# IMPORTANT:
# 1. This file (.env.example) is a safe template committed to Git.
# 2. Copy this file to .env ONLY for local server/CLI tooling if needed.
# 3. NEVER commit a real .env, .env.local, .env.production, server/.env, or
#    supabase/functions/.env containing secret keys, service_role keys,
#    database passwords, webhook secrets, or Brevo SMTP/API keys to Git.
# 4. NEVER prefix any server-side secret with VITE_ (variables prefixed with
#    VITE_ are treated as public client variables).

# ----------------------------------------------------------------------------
# SECTION 1: Public Client-Safe Supabase Configuration
# Consumed by: Browser/PWA (src/js/app.js -> RuntimeConfigLoader),
#              Capacitor Android & iOS (config/screensync.config.json),
#              and Supabase Edge Functions (public URL/anon fallback).
# Security: Safe for client bundles; data isolation is enforced by Supabase
#           Auth and PostgreSQL Row Level Security (ENABLE + FORCE RLS) across
#           all 20 public tables.
# ----------------------------------------------------------------------------
SUPABASE_URL=https://ldephpgydnsovhlkuzbe.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_8mgpzcakPnNv8Z3g5lB_fg_86vpH-_q
SUPABASE_PROJECT_REF=ldephpgydnsovhlkuzbe
VITE_SUPABASE_URL=https://ldephpgydnsovhlkuzbe.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_8mgpzcakPnNv8Z3g5lB_fg_86vpH-_q

# ----------------------------------------------------------------------------
# SECTION 2: Server-Side & Supabase Dashboard-Only Secrets (NEVER IN CLIENT)
# Consumed by:
#   - SUPABASE_SERVICE_ROLE_KEY: Supabase Edge Function (supabase/functions/delete-account/index.ts)
#     Configure in production via: Supabase Dashboard -> Edge Functions -> Secrets
#   - BREVO_SMTP_PASSWORD / BREVO_API_KEY: Supabase Auth Custom SMTP Relay
#     Configure strictly inside: Supabase Dashboard -> Authentication -> SMTP Settings
#       * Host: smtp-relay.brevo.com
#       * Port: 587
#       * Sender email: nawyazahammedhridoy2003@gmail.com
#       * Sender name: ScreenSync
#       * Minimum interval per user: 60 seconds
#       * Email OTP Length: 6 digits
#       * Email OTP Expiration: 3600 seconds (1 hour)
#   - SCREENSYNC_BILLING_WEBHOOK_SECRET: Local/Cloud Node Sync Server (server/sync_server.js)
#     Configure in server host environment only.
# ----------------------------------------------------------------------------
# SUPABASE_SERVICE_ROLE_KEY=NEVER_PLACE_IN_CLIENT_BUNDLE
# SUPABASE_SECRET_KEY=NEVER_PLACE_IN_CLIENT_BUNDLE
# BREVO_SMTP_PASSWORD=CONFIGURED_IN_SUPABASE_DASHBOARD_ONLY
# BREVO_API_KEY=CONFIGURED_IN_SUPABASE_DASHBOARD_ONLY
# SCREENSYNC_BILLING_WEBHOOK_SECRET=SERVER_SIDE_ONLY_WEBHOOK_SECRET

# ----------------------------------------------------------------------------
# SECTION 3: Local Web Preview, Sync Server & Desktop Companion Ports
# Consumed by:
#   - SCREENSYNC_PORT (3000): Static web server (package.json `npm start` / `npm run dev`)
#   - SCREENSYNC_SYNC_HOST (127.0.0.1) & SCREENSYNC_SYNC_PORT (3001):
#     Canonical Local Sync, Companion Tick & Browser Extension Events Server
#     (server/sync_server.js, config/screensync.config.json, platforms/browser-extension/)
#   - SCREENSYNC_SYNC_FALLBACK_PORT (8788): Fallback local sync server port
#   - SCREENSYNC_COMPANION_PORT (19540) & SCREENSYNC_COMPANION_FALLBACK_PORT (17935):
#     Native Desktop Companion HTTP Bridge (Windows C#, macOS Swift, Linux Python,
#     and Multi-Purpose Dynamic Island companion sync)
# ----------------------------------------------------------------------------
SCREENSYNC_ENV=production
SCREENSYNC_PORT=3000
SCREENSYNC_SYNC_HOST=127.0.0.1
SCREENSYNC_SYNC_PORT=3001
SCREENSYNC_SYNC_FALLBACK_PORT=8788
SCREENSYNC_COMPANION_PORT=19540
SCREENSYNC_COMPANION_FALLBACK_PORT=17935
SCREENSYNC_REQUIRE_SYNC_AUTH=0
SCREENSYNC_STRICT_CONFIG_DRIFT=0
SCREENSYNC_DB_PATH=./screensync.db
REDIS_URL=redis://127.0.0.1:6379

# ----------------------------------------------------------------------------
# SECTION 4: Cross-Platform Tracking Thresholds
# Consumed by: src/js/app.js (RuntimeConfigLoader, ReelTrackingEngine,
#              ScreenTimeAggregator, SoundExposureAndHealthService) and
#              config/screensync.config.json
# ----------------------------------------------------------------------------
SCREENSYNC_IDLE_THRESHOLD_SECONDS=300
SCREENSYNC_MAX_TICK_GAP_SECONDS=60
SCREENSYNC_CHECKPOINT_INTERVAL_MINUTES=5
SCREENSYNC_MIN_PERSISTED_SEGMENT_SECONDS=30
SCREENSYNC_JOIN_TOLERANCE_SECONDS=2
SCREENSYNC_WEBSITE_POLL_INTERVAL_SECONDS=7
SCREENSYNC_REEL_SETTLE_DEBOUNCE_MS=300
SCREENSYNC_REEL_MIN_DWELL_MS=1200
SCREENSYNC_SOUND_HARMFUL_DB_THRESHOLD=75.0
SCREENSYNC_SOUND_CONTINUOUS_EXPOSURE_SECONDS=1800
