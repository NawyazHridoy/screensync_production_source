{
  "manifest_version": 3,
  "name": "ScreenSync Cross-Platform Web & Short-Form Companion",
  "short_name": "ScreenSync",
  "version": "3.5.0",
  "minimum_chrome_version": "109",
  "offline_enabled": true,
  "homepage_url": "https://screensync.io",
  "description": "Privacy-preserving browser companion for ScreenSync on Windows, macOS, Linux, and ChromeOS. Classifies short-form video sessions in memory and persists only eTLD+1 hostnames.",
  "permissions": [
    "storage",
    "tabs",
    "idle",
    "alarms",
    "notifications",
    "scripting",
    "history"
  ],
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "ScreenSync Wellness Companion",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "options_page": "options.html",
  "background": {
    "service_worker": "background_collector.js"
  },
  "content_scripts": [
    {
      "matches": [
        "*://*.youtube.com/*",
        "*://*.youtu.be/*",
        "*://*.instagram.com/*",
        "*://*.tiktok.com/*",
        "*://*.facebook.com/*",
        "*://*.fb.com/*",
        "*://*.messenger.com/*",
        "*://*.snapchat.com/*",
        "*://*.x.com/*",
        "*://*.twitter.com/*",
        "*://*.reddit.com/*"
      ],
      "js": [
        "content_shortform_observer.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "http://localhost/*",
        "http://127.0.0.1/*",
        "https://*.screensync.app/*",
        "https://*.screensync.io/*"
      ],
      "js": [
        "content_bridge.js"
      ],
      "run_at": "document_start"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "index.html",
        "popup.html",
        "options.html",
        "icons/*"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ]
}
