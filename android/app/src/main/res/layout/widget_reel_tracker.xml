<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widgetReelRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_liquid_glass_widget"
    android:orientation="vertical"
    android:padding="14dp">

    <TextView
        android:id="@+id/widgetReelTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="ScreenSync • Reel Tracker"
        android:textColor="#6EE7B7"
        android:textSize="11sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/widgetReelsCountText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:text="0 Reels"
        android:textColor="#FFFFFF"
        android:textSize="22sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/widgetReelWatchTimeText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:text="0m watched"
        android:textColor="#E2E8F0"
        android:textSize="11sp" />

    <ProgressBar
        android:id="@+id/widgetReelGoalProgressBar"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="6dp"
        android:layout_marginTop="8dp"
        android:max="100"
        android:progress="0"
        android:progressTint="#34F5A6" />
</LinearLayout>
